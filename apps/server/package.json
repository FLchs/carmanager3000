{
  "name": "@cm3k/server",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "openapi": "bun run --hot src/openapi.ts",
    "openapi:generate": "bun run src/openapi-generate.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@cm3k/contract": "workspace:*",
    "@cm3k/validation": "workspace:*",
    "@hono/swagger-ui": "^0.5.3",
    "@libsql/client": "^0.17.0",
    "@orpc/client": "^1.13.4",
    "@orpc/experimental-pino": "^1.13.4",
    "@orpc/openapi": "^1.13.4",
    "@orpc/server": "^1.13.4",
    "@orpc/zod": "^1.13.4",
    "drizzle-orm": "^1.0.0-beta.9-e89174b",
    "drizzle-seed": "^1.0.0-beta.9-e89174b",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.11.7",
    "hono-pino": "^0.10.3",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "swagger-ui": "^5.31.0",
    "swagger-ui-dist": "^5.31.0",
    "true-myth": "^9.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/swagger-ui": "^5.21.1",
    "@types/swagger-ui-dist": "^3.30.6",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "^4.0.18",
    "drizzle-kit": "^0.31.8",
    "globals": "^17.3.0",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "vitest": "^4.0.18"
  }
}
